---
import '../styles/global.css';
import { SITE, linkWhatsapp } from '../lib/site';

interface Props {
  titulo: string;
  descricao: string;
  caminho: string; // ex.: "/" ou "/artigos/pensao-por-morte"
  tipo?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  menuAtivo?: 'artigos';
}
const { titulo, descricao, caminho, tipo = 'website', jsonLd, noindex = false, menuAtivo } = Astro.props;
const canonical = new URL(caminho, SITE.url).href;
const lds = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content="#0d1b2a" />
  <meta property="og:type" content={tipo} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.nome} />
  <meta property="og:locale" content="pt_BR" />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet" />
  {lds.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
</head>
<body>
  <nav aria-label="Principal">
    <a href="/" class="nav-logo">MM <span>Advocacia</span></a>
    <div class="nav-links">
      <a href="/#atuacao" class="so-desktop">Atuação</a>
      <a href="/artigos" aria-current={menuAtivo === 'artigos' ? 'page' : undefined}>Artigos</a>
      <a href="/#sobre" class="so-desktop">Sobre</a>
      <a href="/#contato">Contato</a>
    </div>
  </nav>
  <main>
    <slot />
  </main>
  <footer>
    <span class="footer-logo">{SITE.nome}</span>
    <span>{SITE.area} · {SITE.oab} · <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={linkWhatsapp()} target="_blank" rel="noopener">WhatsApp</a></span>
  </footer>
</body>
</html>
